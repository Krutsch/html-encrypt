{
  "name": "html-encrypt",
  "version": "1.3.2",
  "type": "module",
  "description": "Password protect a static HTML page without server",
  "bin": "./dist/encrypt.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krutsch/html-encrypt.git"
  },
  "bugs": "https://github.com/Krutsch/html-encrypt/issues",
  "scripts": {
    "start": "tsc",
    "test": "npx tsc && node dist/encrypt.js dist/index.html --own-template && npx serve dist"
  },
  "keywords": [
    "javascript",
    "html",
    "cli",
    "TypeScript",
    "password",
    "crypto"
  ],
  "author": "Fabian Klingenberg <klingenberg.fabian@gmx.de> (https://klingenberg.works/)",
  "license": "MIT",
  "dependencies": {
    "esbuild": "^0.28.1",
    "html-minifier-terser": "^7.2.0"
  },
  "devDependencies": {
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
